{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertMessage",
  "description": "Disaster alert event representing a critical situation detected by the local EOC",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "area_id",
    "timestamp",
    "disaster_type",
    "alert_level",
    "measurements"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this alert event (UUID v4 format)"
    },
    "area_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,}$",
      "minLength": 2,
      "maxLength": 10,
      "description": "Geographic area identifier (uppercase, 2-10 chars). Examples: HCM, HANOI, DANANG"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in ISO 8601 format (e.g., 2026-05-31T14:30:00Z)"
    },
    "disaster_type": {
      "type": "string",
      "enum": ["FLOOD", "TYPHOON", "HEATWAVE", "LANDSLIDE"],
      "description": "Classification of disaster type"
    },
    "alert_level": {
      "type": "string",
      "enum": ["GREEN", "YELLOW", "ORANGE", "RED"],
      "description": "Severity level of the alert. RED = highest priority"
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "description": "Array of sensor measurements that triggered this alert. Must have at least one measurement.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_type",
          "value",
          "unit",
          "confidence"
        ],
        "properties": {
          "sensor_type": {
            "type": "string",
            "enum": [
              "WATER_LEVEL",
              "WIND_SPEED",
              "TEMPERATURE",
              "RAINFALL",
              "GROUND_MOVEMENT",
              "HUMIDITY"
            ],
            "description": "Type of sensor that produced this measurement"
          },
          "value": {
            "type": "number",
            "description": "Measured value"
          },
          "unit": {
            "type": "string",
            "enum": ["mm", "cm", "m", "km/h", "°C", "°F", "%", "mm/h"],
            "description": "Unit of measurement"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence score between 0.0 (low) and 1.0 (high)"
          }
        }
      }
    }
  }
}
